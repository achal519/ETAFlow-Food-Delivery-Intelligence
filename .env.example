# ETAFlow Environment Configuration Template
# Copy this file to .env and configure local environment settings.
# NEVER commit the actual .env file or sensitive secrets to version control.

# Application Environment (development, staging, production)
APP_ENV=development
LOG_LEVEL=INFO

# Storage & Data Paths
DATA_DIR=data
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
REFERENCE_DATA_PATH=data/reference
MODELS_DIR=models
REPORTS_DIR=reports

# API & Service Configuration
API_HOST=127.0.0.1
API_PORT=8000
